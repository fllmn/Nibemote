# Serial (RS485 adapter on the RPi3). 19200 8N1 is the Nibe F/VVM bus default.
NIBEMOTE_SERIAL_PORT=/dev/ttyUSB0
NIBEMOTE_BAUD=19200
NIBEMOTE_PARITY=N
NIBEMOTE_STOPBITS=1
# Comma separated hex/dec bus addresses we answer as. On a live VVM300+F2025 the
# display card is 0x00F9 (use `nibemote scan` to confirm); 0x14 is the old RCU.
NIBEMOTE_ACK_ADDRESSES=0xF9,0x14
# true = drive RTS for RS485 direction (many USB/RS485 adapters and HATs), false = auto
NIBEMOTE_RS485_RTS=true

# MQTT broker (Home Assistant Mosquitto add-on or similar)
NIBEMOTE_MQTT_HOST=localhost
NIBEMOTE_MQTT_PORT=1883
NIBEMOTE_MQTT_USER=
NIBEMOTE_MQTT_PASSWORD=
NIBEMOTE_MQTT_TOPIC_PREFIX=nibemote
NIBEMOTE_HA_DISCOVERY_PREFIX=homeassistant
NIBEMOTE_HA_DISCOVERY=true

# Poll loop
NIBEMOTE_POLL_INTERVAL=5.0
NIBEMOTE_READ_TIMEOUT=10.0
# Set true if 32-bit register values decode with swapped 16-bit words
# (check service menu 5.3.11 "word swap" on the pump and match it here)
NIBEMOTE_WORD_SWAP=false

NIBEMOTE_LOG_LEVEL=INFO
